# SvelteKit specific build and generated files
.svelte-kit/
build/
.vite/
vite.config.ts.*

# Package manager dependencies
node_modules/

# Local environment variables and secrets
.env
.env.local
.env.*.local
!.env.example

# Production builds and outputs
dist/

# Log files
Lines starting with # are comments.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust build artifacts
target/
src-tauri/target/
# Tauri generated schemas/permissions
src-tauri/gen/

# Local WhatsApp session databases (created at runtime)
*.db
*.db-shm
*.db-wal

# Editor and OS-specific files
.DS_Store
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
CLAUDE.md
.claude/

# graphify: publish the graph artifacts, not the rebuild cache
graphify-out/cache/
graphify-out/.graphify_root
graphify-out/.graphify_python
graphify-out/*.json.sig
# graphify: keep local memory out of shared repository
graphify-out/memory/
graphify-out/reflections/
graphify-out/.graphify_learning.json
graphify-out/2026-*
