{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "whatsvelte-rust",
  "version": "1.4.0",
  "identifier": "com.ravesandstorm.whatsvelte-rust",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../svelte-frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../svelte-frontend"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../svelte-frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Wha.rs.app",
        "width": 1100,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "media-src": "'self' asset: http://asset.localhost blob: https:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost https://api.klipy.com https://*.klipy.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/media/**",
          "$APPLOCALDATA/media/**"
        ]
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": [
          "English"
        ]
      }
    }
  }
}
