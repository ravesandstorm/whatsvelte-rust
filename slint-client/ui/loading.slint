import { Spinner, ProgressIndicator } from "std-widgets.slint";
import { AppState, Theme } from "state.slint";
import { PrimaryButton } from "widgets.slint";

export component ConnectionPill inherits Rectangle {
    height: 26px;
    width: t.preferred-width + 34px;
    border-radius: 13px;
    background: Theme.panel-alt;
    Rectangle {
        x: 12px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: AppState.connected ? Theme.unread : #f0b232;
    }
    t := Text {
        x: 26px;
        text: AppState.connected ? "Connected" : "Connecting…";
        color: Theme.text-muted;
        font-size: Theme.fs-small;
        vertical-alignment: center;
    }
}

export component LoadingScreen inherits Rectangle {
    background: Theme.panel-alt;
    VerticalLayout {
        alignment: center;
        spacing: 18px;
        HorizontalLayout {
            alignment: center;
            Spinner {
                width: 48px;
                height: 48px;
                indeterminate: AppState.loading-total == 0;
                progress: AppState.loading-total == 0 ? 0 : AppState.loading-done / AppState.loading-total;
            }
        }
        Text {
            text: "Wha.rs.app";
            color: Theme.text;
            font-size: Theme.fs-title;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: AppState.loading-label;
            color: Theme.text-muted;
            font-size: Theme.fs;
            horizontal-alignment: center;
        }
        if AppState.loading-total > 0: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                ProgressIndicator {
                    width: 280px;
                    height: 6px;
                    progress: AppState.loading-done / AppState.loading-total;
                }
            }
            Text {
                text: AppState.loading-done + " of " + AppState.loading-total + " chats · "
                    + round(AppState.loading-done * 100 / AppState.loading-total) + "%";
                color: Theme.text-muted;
                font-size: Theme.fs-small;
                horizontal-alignment: center;
            }
        }
        HorizontalLayout {
            alignment: center;
            ConnectionPill { }
        }
        HorizontalLayout {
            alignment: center;
            PrimaryButton {
                label: AppState.resetting ? "Resetting…" : "Stuck? Log out & reset";
                enabled: !AppState.resetting;
                danger: true;
                clicked => { AppState.reset-session(); }
            }
        }
        Text {
            text: "🔒 End-to-end encrypted";
            color: Theme.text-muted;
            font-size: Theme.fs-small;
            horizontal-alignment: center;
        }
    }
}
