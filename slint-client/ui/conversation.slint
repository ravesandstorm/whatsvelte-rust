import { ListView } from "std-widgets.slint";
import { AppState, Theme, MsgRow, AlbumTile } from "state.slint";
import { Avatar, IconButton, MenuRow, TextField, Ticks } from "widgets.slint";

// ---------------------------------------------------------------- album grid

component AlbumTileView inherits Rectangle {
    in property <AlbumTile> tile;
    callback clicked();
    border-radius: 6px;
    clip: true;
    background: Theme.quote-bg;
    if tile.has-image: Image {
        width: parent.width;
        height: parent.height;
        source: tile.image;
        image-fit: cover;
    }
    if !tile.has-image: Text {
        text: tile.is-video ? "🎬" : "🖼";
        font-size: 24px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if tile.is-video && tile.more == 0: Rectangle {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: #00000088;
        Text { text: "▶"; color: #ffffff; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
    }
    if tile.more > 0: Rectangle {
        background: #00000099;
        Text { text: "+" + tile.more; color: #ffffff; font-size: 26px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component AlbumGrid inherits Rectangle {
    in property <[AlbumTile]> tiles;
    callback open(AlbumTile);
    property <length> gap: 3px;
    property <length> cell: (300px - gap) / 2;
    width: 300px;
    height: tiles.length == 2 ? cell : cell * 2 + gap;
    for t[i] in tiles: AlbumTileView {
        tile: t;
        x: tiles.length == 3 && i == 2 ? 0 : mod(i, 2) * (cell + gap);
        y: i < 2 ? 0 : cell + gap;
        width: tiles.length == 3 && i == 2 ? 300px : cell;
        height: cell;
        clicked => { root.open(t); }
    }
}

// ---------------------------------------------------------------- emoji grid

export component EmojiGrid inherits Rectangle {
    in property <[string]> emojis;
    in property <string> highlight;
    in property <int> columns: 8;
    callback picked(string);
    property <length> cell: 36px;
    flick := Flickable {
        content-height: ceil(emojis.length / columns) * cell + 8px;
        for e[i] in emojis: Rectangle {
            x: 4px + mod(i, columns) * cell;
            y: 4px + floor(i / columns) * cell;
            width: cell - 2px;
            height: cell - 2px;
            border-radius: 6px;
            background: e == root.highlight ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
            Text { text: e; font-size: 21px; horizontal-alignment: center; vertical-alignment: center; }
            ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(e); } }
        }
    }
}

// Category tabs + search + grid, shared by the composer panel and the
// reaction picker. The data comes from AppState (Rust filters/searches).
export component EmojiPanelBody inherits VerticalLayout {
    in property <string> highlight;
    callback picked(string);
    spacing: 4px;
    TextField {
        height: 32px * Theme.zoom;
        placeholder: "Search emoji";
        text <=> AppState.emoji-search;
        edited(t) => { AppState.emoji-search-changed(t); }
    }
    if AppState.emoji-search == "": HorizontalLayout {
        height: 30px;
        spacing: 2px;
        for tab[i] in AppState.emoji-tabs: Rectangle {
            width: 32px;
            border-radius: 6px;
            background: AppState.emoji-tab == i ? Theme.selected : tta.has-hover ? Theme.hover : transparent;
            Text { text: tab.icon; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
            tta := TouchArea { mouse-cursor: pointer; clicked => { AppState.emoji-tab-changed(i); } }
        }
    }
    if AppState.emoji-grid.length == 0: Text {
        vertical-stretch: 1;
        text: AppState.emoji-empty;
        color: Theme.text-muted;
        font-size: Theme.fs-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if AppState.emoji-grid.length > 0: EmojiGrid {
        vertical-stretch: 1;
        emojis: AppState.emoji-grid;
        highlight: root.highlight;
        picked(e) => { root.picked(e); }
    }
}

// ---------------------------------------------------------------- bubble

component Bubble inherits Rectangle {
    in property <MsgRow> msg;
    in property <length> max-bubble: 520px;
    // the pane is waiting for this row to report its position
    in property <bool> reveal-pending;
    callback copy-text(string);
    callback reveal(length, length);

    property <length> img-w: msg.sticker ? 140px : (msg.has-image ? min(300px, max(120px, msg.image-w * 1px)) : 0);
    property <length> img-h: msg.has-image && msg.image-w > 0 ? min(msg.sticker ? 140px : 360px, img-w * msg.image-h / msg.image-w) : img-w;

    // Read-on-view: rows only exist while (nearly) on screen in the ListView.
    property <string> seen-key: msg.unread ? msg.id : "";
    init => {
        if seen-key != "" { AppState.seen(seen-key); }
        if want-reveal { root.reveal(root.y, root.height); }
    }
    changed seen-key => { if seen-key != "" { AppState.seen(seen-key); } }
    property <bool> want-reveal: root.reveal-pending && msg.id == AppState.reveal-id;
    changed want-reveal => { if want-reveal { root.reveal(root.y, root.height); } }
    changed y => { if want-reveal { root.reveal(root.y, root.height); } }

    // flash highlight after jumping to a quoted message
    Rectangle {
        background: Theme.accent.transparentize(0.72);
        opacity: msg.flash ? 1 : 0;
        animate opacity { duration: 600ms; }
    }

    VerticalLayout {
        padding-left: 56px * Theme.zoom;
        padding-right: 56px * Theme.zoom;
        padding-top: msg.grouped ? 1px : 5px;
        padding-bottom: msg.reactions != "" ? 15px : 1px;

        // day separator
        if msg.day != "": HorizontalLayout {
            alignment: center;
            padding-top: 8px;
            padding-bottom: 8px;
            Rectangle {
                background: Theme.panel;
                border-radius: 7px;
                drop-shadow-blur: 1px;
                drop-shadow-color: #0000001a;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    Text { text: msg.day; color: Theme.text-muted; font-size: Theme.fs-small; }
                }
            }
        }

        // unread divider
        if msg.unread-divider: HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 10px;
            Rectangle { height: 1px; y: (parent.height - 1px) / 2; background: Theme.divider; horizontal-stretch: 1; }
            Rectangle {
                background: Theme.panel;
                border-radius: 10px;
                width: ut.preferred-width + 24px;
                height: 22px;
                ut := Text { text: "Unread"; color: Theme.unread; font-size: Theme.fs-small; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle { height: 1px; y: (parent.height - 1px) / 2; background: Theme.divider; horizontal-stretch: 1; }
        }

        HorizontalLayout {
            alignment: msg.from-me ? end : start;
            bubble := Rectangle {
                max-width: root.max-bubble;
                background: msg.sticker ? transparent : (msg.from-me ? Theme.bubble-out : Theme.bubble-in);
                border-radius: 8px;
                drop-shadow-blur: msg.sticker ? 0 : 1px;
                drop-shadow-color: #00000020;

                hover := TouchArea {
                    double-clicked => { if msg.can-reply { AppState.reply-to(msg.id); } }
                    pointer-event(ev) => {
                        if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                            menu.show();
                        }
                    }
                }

                VerticalLayout {
                    padding: msg.sticker ? 0 : 6px;
                    padding-left: msg.sticker ? 0 : 9px;
                    padding-right: msg.sticker ? 0 : 9px;
                    spacing: 3px;

                    if msg.show-sender: Text {
                        text: msg.sender;
                        color: msg.tint;
                        font-size: Theme.fs-small;
                        font-weight: 600;
                        overflow: elide;
                    }

                    if msg.has-quote && !msg.deleted: Rectangle {
                        background: Theme.quote-bg;
                        border-radius: 6px;
                        min-width: 160px;
                        HorizontalLayout {
                            Rectangle { width: 4px; background: Theme.accent; border-radius: 2px; }
                            VerticalLayout {
                                padding: 6px;
                                padding-left: 8px;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: msg.quote-sender; color: Theme.accent; font-size: Theme.fs-small; font-weight: 600; overflow: elide; }
                                Text { text: msg.quote-text; color: Theme.text-muted; font-size: Theme.fs-small; overflow: elide; }
                            }
                            if msg.has-quote-thumb: Image {
                                width: 34px;
                                height: 34px;
                                y: (parent.height - 34px) / 2;
                                source: msg.quote-thumb;
                                image-fit: cover;
                            }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { AppState.reveal-quote(msg.quote-id); } }
                    }

                    if msg.is-album && !msg.deleted: AlbumGrid {
                        tiles: msg.album;
                        open(t) => {
                            if t.more > 0 { AppState.open-album(msg.id); } else { AppState.view-image(t.id); }
                        }
                    }

                    if msg.has-image && !msg.is-album: Rectangle {
                        width: root.img-w;
                        height: root.img-h;
                        border-radius: 6px;
                        clip: true;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: msg.image;
                            image-fit: msg.sticker ? contain : cover;
                        }
                        if msg.loading-media: Rectangle {
                            background: #00000044;
                            Text { text: "⏳"; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        if msg.kind == "video": Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 24px;
                            background: #00000088;
                            Text { text: "▶"; color: #ffffff; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { if !msg.sticker { AppState.view-image(msg.id); } }
                            pointer-event(ev) => {
                                if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                                    menu.show();
                                }
                            }
                        }
                    }

                    if msg.is-audio && !msg.deleted: Rectangle {
                        background: Theme.quote-bg;
                        border-radius: 6px;
                        width: 260px;
                        height: 48px * Theme.zoom;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 10px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: msg.loading-media ? "⏳" : msg.audio-playing ? "⏸" : "▶";
                                    size: 34px;
                                    fg: Theme.accent;
                                    clicked => { AppState.toggle-audio(msg.id); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Rectangle {
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.divider;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * clamp(msg.audio-progress, 0, 1);
                                        border-radius: 2px;
                                        background: Theme.accent;
                                    }
                                }
                                Text { text: msg.audio-label; color: Theme.text-muted; font-size: Theme.fs-tiny; }
                            }
                        }
                    }

                    if msg.has-media && !msg.has-image && !msg.is-audio && !msg.is-album: Rectangle {
                        background: Theme.quote-bg;
                        border-radius: 6px;
                        min-width: 220px;
                        height: 48px * Theme.zoom;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 8px;
                            Text {
                                text: msg.media-label;
                                color: Theme.text;
                                font-size: Theme.fs;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: msg.loading-media ? "⏳" : "↗";
                                    size: 32px;
                                    fg: Theme.accent;
                                    clicked => { AppState.open-media(msg.id); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: "⬇";
                                    size: 32px;
                                    clicked => { AppState.save-media(msg.id); }
                                }
                            }
                        }
                    }

                    if msg.deleted: Text {
                        text: "🚫 This message was deleted";
                        color: Theme.text-muted;
                        font-size: Theme.fs;
                        font-italic: true;
                    }

                    if !msg.deleted && msg.text != "" && !msg.has-links: TextInput {
                        text: msg.text;
                        read-only: true;
                        color: Theme.text;
                        font-size: Theme.fs;
                        wrap: word-wrap;
                        single-line: false;
                        selection-background-color: Theme.accent.transparentize(0.6);
                    }
                    if !msg.deleted && msg.has-links: StyledText {
                        text: msg.rich;
                        default-color: Theme.text;
                        default-font-size: Theme.fs;
                        link-color: Theme.tick-read;
                        link-clicked(l) => { AppState.open-link(l); }
                    }

                    if !msg.deleted && msg.structured != "": Text {
                        text: "〔" + msg.structured + "〕";
                        color: Theme.text-muted;
                        font-size: Theme.fs-small;
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 4px;
                        if msg.edited && !msg.deleted: Text { text: "edited"; color: Theme.text-muted; font-size: Theme.fs-tiny; }
                        Text { text: msg.time; color: msg.sticker ? Theme.text : Theme.text-muted; font-size: Theme.fs-tiny; }
                        if msg.from-me: Ticks { status: msg.status; }
                        if msg.status == 1: Text {
                            text: "Not sent · Retry";
                            color: Theme.danger;
                            font-size: Theme.fs-tiny;
                            TouchArea { mouse-cursor: pointer; clicked => { AppState.retry(msg.id); } }
                        }
                    }
                }

                if msg.reactions != "": Rectangle {
                    x: msg.from-me ? parent.width - self.width - 8px : 8px;
                    y: parent.height - 6px;
                    height: 22px;
                    width: rt.preferred-width + 14px;
                    border-radius: 11px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.divider;
                    rt := Text { text: msg.reactions; color: Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }

                // hover actions: reply / edit / react / menu
                if hover.has-hover && !msg.deleted && !msg.pending: Rectangle {
                    x: parent.width - self.width - 2px;
                    y: 2px;
                    height: 24px;
                    width: actions.preferred-width;
                    border-radius: 12px;
                    background: msg.from-me ? Theme.bubble-out : Theme.bubble-in;
                    actions := HorizontalLayout {
                        IconButton { icon: "↩"; size: 24px; clicked => { AppState.reply-to(msg.id); } }
                        if msg.can-edit: IconButton { icon: "✏"; size: 24px; clicked => { AppState.edit(msg.id); } }
                        IconButton { icon: "🙂"; size: 24px; clicked => { AppState.open-reactions(msg.id); } }
                        IconButton { icon: "▾"; size: 24px; clicked => { menu.show(); } }
                    }
                }

                menu := PopupWindow {
                    x: msg.from-me ? parent.width - 220px : 0;
                    y: min(parent.height, 26px);
                    width: 220px;
                    close-policy: close-on-click-outside;
                    Rectangle {
                        background: Theme.panel;
                        border-radius: 6px;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000040;
                        VerticalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            if msg.can-reply: MenuRow { label: "Reply"; clicked => { AppState.reply-to(msg.id); menu.close(); } }
                            if msg.can-reply: MenuRow { label: "React"; clicked => { AppState.open-reactions(msg.id); menu.close(); } }
                            if msg.can-edit: MenuRow { label: "Edit"; clicked => { AppState.edit(msg.id); menu.close(); } }
                            if msg.text != "" && !msg.deleted: MenuRow { label: "Copy text"; clicked => { root.copy-text(msg.text); menu.close(); } }
                            if msg.has-media && !msg.deleted: MenuRow { label: "Open"; clicked => { AppState.open-media(msg.id); menu.close(); } }
                            if msg.has-media && !msg.deleted: MenuRow { label: "Save to Downloads"; clicked => { AppState.save-media(msg.id); menu.close(); } }
                            if msg.can-delete: MenuRow { label: "Delete"; danger: true; clicked => { AppState.ask-delete(msg.id); menu.close(); } }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- pane

export component ConversationPane inherits Rectangle {
    callback copy-text(string);
    clip: true;

    // ---- scroll state
    property <int> settle;
    property <bool> reveal-pending;
    property <bool> loading-older;
    property <length> prev-height;
    property <length> distance-from-bottom: list.content-height + list.content-y - list.visible-height;
    property <bool> at-bottom: distance-from-bottom < 40px;

    function scroll-bottom() {
        list.content-y = min(0px, list.visible-height - list.content-height);
    }
    property <int> scroll-token: AppState.scroll-token;
    changed scroll-token => { root.reveal-pending = false; root.settle = 5; root.scroll-bottom(); }

    // Jump to a row: estimate from its index, then the row reports its exact
    // position once the (virtualized) list instantiates it.
    property <int> reveal-token: AppState.reveal-token;
    property <bool> reveal-resolved;
    property <int> reveal-tries;
    function reveal-estimate() {
        list.content-y = clamp(-(AppState.reveal-index / max(1, AppState.messages.length)) * list.content-height,
            min(0px, list.visible-height - list.content-height), 0px);
    }
    // The pane is created lazily (after the first frame set the tokens), so
    // replay whatever position the first frame asked for.
    init => {
        if AppState.reveal-token > 0 && AppState.reveal-id != "" { root.start-reveal(); } else { root.settle = 5; }
    }
    changed reveal-token => { root.start-reveal(); }
    function start-reveal() {
        root.settle = 0;
        root.reveal-pending = true;
        root.reveal-resolved = false;
        root.reveal-tries = 0;
        root.reveal-estimate();
    }
    // Re-estimate until the target row is instantiated and reports itself,
    // then keep refining briefly while row heights settle.
    Timer {
        interval: 50ms;
        running: root.reveal-pending;
        triggered => {
            root.reveal-tries += 1;
            if !root.reveal-resolved { root.reveal-estimate(); }
            if root.reveal-tries > 16 { root.reveal-pending = false; }
        }
    }
    // ListView measures rows lazily; re-apply for a few frames so the estimate settles.
    Timer {
        interval: 40ms;
        running: root.settle > 0;
        triggered => { root.scroll-bottom(); root.settle -= 1; }
    }
    // Back at the bottom for a moment: let Rust release older pages / mark read.
    changed at-bottom => { if at-bottom { bottom-timer.running = true; } }
    bottom-timer := Timer {
        interval: 250ms;
        running: false;
        triggered => {
            self.running = false;
            if root.at-bottom && AppState.messages.length > 0 { AppState.reached-bottom(); }
        }
    }
    property <int> focus-token: AppState.focus-token;
    changed focus-token => { input.focus(); }
    property <int> caret-token: AppState.caret-token;
    changed caret-token => { input.set-selection-offsets(AppState.composer-caret, AppState.composer-caret); }

    // ---- empty state
    if AppState.active-jid == "": Rectangle {
        background: Theme.panel-alt;
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            Text { text: "Wha.rs.app"; color: Theme.text; font-size: 32px * Theme.zoom; font-weight: 300; horizontal-alignment: center; }
            Text {
                text: "Select a chat to start messaging.";
                color: Theme.text-muted;
                font-size: Theme.fs;
                horizontal-alignment: center;
            }
        }
    }

    VerticalLayout {
        visible: AppState.active-jid != "";

        // header
        Rectangle {
            height: 60px * Theme.zoom;
            background: Theme.panel-alt;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 10px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Avatar {
                        initials: AppState.active-initials;
                        tint: AppState.active-tint;
                        picture: AppState.active-avatar;
                        has-picture: AppState.active-has-avatar;
                        size: 40px * Theme.zoom;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: AppState.active-title; color: Theme.text; font-size: Theme.fs-large; overflow: elide; }
                    if AppState.active-subtitle != "": Text { text: AppState.active-subtitle; color: Theme.text-muted; font-size: Theme.fs-small; overflow: elide; }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton { icon: AppState.active-muted ? "🔇" : "🔔"; active: AppState.active-muted; clicked => { AppState.toggle-mute(); } }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton { icon: "📌"; active: AppState.active-pinned; clicked => { AppState.toggle-pin(); } }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton { icon: "🗄"; active: AppState.active-archived; clicked => { AppState.toggle-archive(); } }
                }
            }
        }

        // messages over the wallpaper
        Rectangle {
            vertical-stretch: 1;
            background: AppState.wallpaper-kind == 1 ? AppState.wallpaper-color
                : AppState.wallpaper-kind == 2 ? @linear-gradient(160deg, #0b141a 0%, #14323a 100%)
                : Theme.chat-bg;
            if AppState.wallpaper-kind == 3: Image {
                width: parent.width;
                height: parent.height;
                source: AppState.wallpaper-image;
                image-fit: cover;
            }

            list := ListView {
                width: parent.width;
                height: parent.height;
                changed content-height => {
                    if root.loading-older {
                        // keep the reading position when older rows are prepended
                        self.content-y -= (self.content-height - root.prev-height);
                        root.loading-older = false;
                    } else if root.settle > 0 {
                        root.scroll-bottom();
                    }
                }
                changed content-y => {
                    if self.content-y > -60px && AppState.has-older && !root.loading-older
                        && !root.reveal-pending && AppState.messages.length > 0 && root.settle == 0 {
                        root.loading-older = true;
                        root.prev-height = self.content-height;
                        AppState.load-older();
                    }
                }
                for msg in AppState.messages: Bubble {
                    msg: msg;
                    max-bubble: min(560px, root.width * 0.65);
                    reveal-pending: root.reveal-pending;
                    copy-text(t) => { root.copy-text(t); }
                    reveal(y, h) => {
                        root.reveal-resolved = true;
                        list.content-y = clamp(
                            -(y - (AppState.reveal-center ? (list.visible-height - h) / 2 : 8px)),
                            min(0px, list.visible-height - list.content-height), 0px);
                    }
                }
            }

            if AppState.has-older && list.content-y > -40px: Rectangle {
                y: 8px;
                x: (parent.width - self.width) / 2;
                background: Theme.panel;
                border-radius: 14px;
                height: 28px;
                width: older.preferred-width + 28px;
                drop-shadow-blur: 2px;
                drop-shadow-color: #00000030;
                older := Text { text: "Showing the latest messages — scroll up for more"; color: Theme.text-muted; font-size: Theme.fs-small; horizontal-alignment: center; vertical-alignment: center; }
            }

            if AppState.messages.length == 0: Text {
                text: "Loading messages…";
                color: Theme.text-muted;
                font-size: Theme.fs-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // jump to bottom
            if !root.at-bottom && AppState.messages.length > 0: Rectangle {
                x: parent.width - 18px - 42px;
                y: parent.height - 16px - 42px;
                width: 42px;
                height: 42px;
                border-radius: 21px;
                background: Theme.panel;
                drop-shadow-blur: 4px;
                drop-shadow-color: #00000040;
                Text { text: "↓"; color: Theme.text-muted; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                if AppState.unread-in-view > 0: Rectangle {
                    x: parent.width - 14px;
                    y: -6px;
                    height: 20px;
                    width: max(20px, bt.preferred-width + 10px);
                    border-radius: 10px;
                    background: Theme.unread;
                    bt := Text { text: AppState.unread-in-view; color: #ffffff; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
                TouchArea { mouse-cursor: pointer; clicked => { AppState.jump-to-bottom(); } }
            }
        }

        // reply / edit banner
        if AppState.replying || AppState.editing: Rectangle {
            background: Theme.panel-alt;
            height: 58px * Theme.zoom;
            HorizontalLayout {
                padding: 8px;
                padding-left: 16px;
                spacing: 8px;
                Rectangle {
                    background: Theme.quote-bg;
                    border-radius: 6px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        Rectangle { width: 4px; background: Theme.accent; border-radius: 2px; }
                        VerticalLayout {
                            padding-left: 8px;
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: AppState.editing ? "Editing message" : AppState.reply-sender; color: Theme.accent; font-size: Theme.fs-small; font-weight: 600; }
                            Text { text: AppState.reply-text; color: Theme.text-muted; font-size: Theme.fs-small; overflow: elide; }
                        }
                        if AppState.has-reply-thumb && AppState.replying: Image {
                            width: 40px;
                            height: 40px;
                            y: (parent.height - 40px) / 2;
                            source: AppState.reply-thumb;
                            image-fit: cover;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton { icon: "×"; clicked => { AppState.cancel-compose(); } }
                }
            }
        }

        // composer
        composer := Rectangle {
            height: clamp(input.preferred-height + 20px, 38px * Theme.zoom, 150px) + 24px;
            background: Theme.panel-alt;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 6px;
                VerticalLayout {
                    alignment: end;
                    IconButton { icon: "😊"; clicked => { picker.show(); } }
                }
                VerticalLayout {
                    alignment: end;
                    IconButton { icon: "📎"; clicked => { attach.show(); } }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    background: Theme.field-alt;
                    border-width: 1px;
                    border-color: input.has-focus ? Theme.accent : transparent;
                    clip: true;
                    keys := FocusScope {
                        capture-key-pressed(ev) => {
                            if AppState.suggestions.length > 0 {
                                if ev.text == Key.UpArrow {
                                    AppState.suggestion-index = mod(AppState.suggestion-index - 1 + AppState.suggestions.length, AppState.suggestions.length);
                                    return accept;
                                }
                                if ev.text == Key.DownArrow {
                                    AppState.suggestion-index = mod(AppState.suggestion-index + 1, AppState.suggestions.length);
                                    return accept;
                                }
                                if ev.text == Key.Return || ev.text == Key.Tab {
                                    AppState.accept-suggestion(AppState.suggestion-index);
                                    return accept;
                                }
                                if ev.text == Key.Escape {
                                    AppState.suggestions = [];
                                    return accept;
                                }
                            }
                            if ev.text == Key.Return {
                                if ev.modifiers.shift { return reject; }
                                if ev.modifiers.control || ev.modifiers.meta || AppState.enter-to-send {
                                    if AppState.composer-text != "" { AppState.send(AppState.composer-text); }
                                    return accept;
                                }
                                return reject;
                            }
                            if ev.text == Key.Escape && (AppState.editing || AppState.replying) {
                                AppState.cancel-compose();
                                return accept;
                            }
                            if (ev.modifiers.control || ev.modifiers.meta) && (ev.text == "v" || ev.text == "V") {
                                AppState.paste-image();
                            }
                            reject
                        }
                        input := TextInput {
                            x: 12px;
                            y: 9px;
                            width: parent.width - 24px;
                            text <=> AppState.composer-text;
                            color: Theme.text;
                            font-size: Theme.fs;
                            single-line: false;
                            wrap: word-wrap;
                            selection-background-color: Theme.accent.transparentize(0.6);
                            edited => {
                                AppState.last-caret = self.cursor-position-byte-offset;
                                AppState.composer-edited(self.text, self.cursor-position-byte-offset);
                            }
                            cursor-position-changed => { AppState.last-caret = self.cursor-position-byte-offset; }
                        }
                    }
                    if AppState.composer-text == "": Text {
                        x: 12px;
                        y: 9px;
                        text: "Type a message";
                        color: Theme.text-muted;
                        font-size: Theme.fs;
                    }
                }
                VerticalLayout {
                    alignment: end;
                    IconButton {
                        icon: "➤";
                        fg: AppState.composer-text != "" ? Theme.accent : Theme.text-muted;
                        clicked => {
                            if AppState.composer-text != "" { AppState.send(AppState.composer-text); }
                            input.focus();
                        }
                    }
                }
            }

            // :shortcode suggestions
            if AppState.suggestions.length > 0: Rectangle {
                x: 100px;
                y: -self.height - 4px;
                width: 260px;
                height: AppState.suggestions.length * 32px + 8px;
                background: Theme.panel;
                border-radius: 8px;
                drop-shadow-blur: 10px;
                drop-shadow-color: #00000040;
                for s[i] in AppState.suggestions: Rectangle {
                    x: 4px;
                    y: 4px + i * 32px;
                    width: parent.width - 8px;
                    height: 32px;
                    border-radius: 6px;
                    background: i == AppState.suggestion-index ? Theme.selected : sta.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 10px;
                        Text { text: s.emoji; font-size: 18px; vertical-alignment: center; }
                        Text { text: ":" + s.code + ":"; color: Theme.text-muted; font-size: Theme.fs-small; vertical-alignment: center; horizontal-alignment: left; horizontal-stretch: 1; }
                    }
                    sta := TouchArea { mouse-cursor: pointer; clicked => { AppState.accept-suggestion(i); } }
                }
            }

            attach := PopupWindow {
                x: 54px;
                y: -4 * 40px - 24px;
                width: 210px;
                close-policy: close-on-click-outside;
                Rectangle {
                    background: Theme.panel;
                    border-radius: 8px;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: #00000040;
                    VerticalLayout {
                        padding-top: 6px;
                        padding-bottom: 6px;
                        MenuRow { label: "🖼️  Photos"; clicked => { attach.close(); AppState.attach-photos(); } }
                        MenuRow { label: "📄  Document"; clicked => { attach.close(); AppState.attach-document(); } }
                        MenuRow { label: "📷  Camera"; clicked => { attach.close(); AppState.attach-camera(); } }
                        MenuRow { label: "🎤  Voice message"; clicked => { attach.close(); AppState.attach-voice(); } }
                    }
                }
            }

            picker := PopupWindow {
                x: 10px;
                y: -300px - 6px;
                width: 320px;
                height: 300px;
                close-policy: close-on-click-outside;
                Rectangle {
                    background: Theme.panel;
                    border-radius: 8px;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #00000050;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        if AppState.picker-tab == 0: EmojiPanelBody {
                            vertical-stretch: 1;
                            picked(e) => { AppState.emoji-picked(e, AppState.last-caret); }
                        }
                        if AppState.picker-tab == 1 && !AppState.gif-configured: VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 6px;
                            Text { text: "GIF search isn't configured."; color: Theme.text; font-size: Theme.fs; horizontal-alignment: center; }
                            Text { text: "Set KLIPY_API_KEY and rebuild (or export it before launching)."; color: Theme.text-muted; font-size: Theme.fs-small; horizontal-alignment: center; wrap: word-wrap; }
                        }
                        if AppState.picker-tab == 1 && AppState.gif-configured: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 6px;
                            TextField {
                                height: 32px * Theme.zoom;
                                placeholder: "Search GIFs";
                                text <=> AppState.gif-query;
                                edited(t) => { AppState.gif-search(t); }
                            }
                            gifs := Flickable {
                                vertical-stretch: 1;
                                property <length> cell-w: (self.width - 6px) / 2;
                                content-height: ceil(AppState.gifs.length / 2) * (cell-w * 0.75 + 6px);
                                changed content-y => {
                                    if self.content-height + self.content-y - self.height < 140px { AppState.gif-more(); }
                                }
                                for g[i] in AppState.gifs: Rectangle {
                                    x: mod(i, 2) * (gifs.cell-w + 6px);
                                    y: floor(i / 2) * (gifs.cell-w * 0.75 + 6px);
                                    width: gifs.cell-w;
                                    height: gifs.cell-w * 0.75;
                                    border-radius: 6px;
                                    clip: true;
                                    background: Theme.quote-bg;
                                    if g.has-image: Image { width: parent.width; height: parent.height; source: g.image; image-fit: cover; }
                                    TouchArea { mouse-cursor: pointer; clicked => { picker.close(); AppState.gif-picked(g.id); } }
                                }
                            }
                            if AppState.gif-status != "": Text { text: AppState.gif-status; color: Theme.text-muted; font-size: Theme.fs-small; horizontal-alignment: center; }
                        }
                        if AppState.picker-tab == 2: Text {
                            vertical-stretch: 1;
                            text: "Stickers coming soon";
                            color: Theme.text-muted;
                            font-size: Theme.fs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            height: 30px;
                            spacing: 4px;
                            for tab[i] in ["😊 Emoji", "GIF", "Stickers"]: Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 6px;
                                background: AppState.picker-tab == i ? Theme.selected : pta.has-hover ? Theme.hover : transparent;
                                Text { text: tab; color: AppState.picker-tab == i ? Theme.accent : Theme.text-muted; font-size: Theme.fs-small; horizontal-alignment: center; vertical-alignment: center; }
                                pta := TouchArea { mouse-cursor: pointer; clicked => { AppState.picker-tab-changed(i); } }
                            }
                        }
                    }
                }
            }
        }
    }
}
